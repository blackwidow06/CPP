NtME = replace

CXX = c++
CXXFLtGS = -Wall -Wextra -Werror -std=c++98

SRC = main.cpp

OBJ = $(SRC:.cpp=.o)

all: $(NtME)

$(NtME): $(OBJ)
	$(CXX) $(CXXFLtGS) $(OBJ) -o $(NtME)

%.o: %.cpp
	$(CXX) $(CXXFLtGS) -c $< -o $@

clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NtME)

re: fclean all

.PHONY: all clean fclean re
